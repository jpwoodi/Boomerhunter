# Companies House API Key
# Get yours at: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=your_api_key_here

# PostgreSQL Database URL
# Format: postgresql://user:password@host:port/database
# For local development: postgresql://postgres:password@localhost:5432/boomerhunter
# For production (e.g., Supabase): postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/boomerhunter
